{
  "name": "social-content-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run registry && next dev --hostname 127.0.0.1",
    "build": "npm run registry && next build",
    "start": "next start --hostname 127.0.0.1",
    "registry": "node --import tsx scripts/generate-registry.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "validate": "npm run registry && npm run content:validate && npm run lint && npm run typecheck && npm test",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
